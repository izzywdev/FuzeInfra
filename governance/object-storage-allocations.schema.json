{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FuzeInfra service object-storage allocations",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "allocations"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "allocations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "enabled", "service", "provider", "bucket", "sourceManifest", "source", "handoffId"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
          "enabled": { "type": "boolean" },
          "service": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,38}$" },
          "provider": { "const": "s3-compatible" },
          "bucket": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,62}$" },
          "sourceManifest": { "type": "string", "pattern": "^deploy/sealed-secrets/[a-z0-9-]+\\.ya?ml$" },
          "handoffId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
          "notes": { "type": "string" },
          "source": {
            "type": "object", "additionalProperties": false,
            "required": ["namespace", "secretName", "secretKey"],
            "properties": {
              "namespace": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
              "secretName": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
              "secretKey": { "const": "config" }
            }
          }
        }
      }
    }
  }
}
