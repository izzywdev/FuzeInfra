{
  "annotations": {"list": []},
  "description": "Backed by Tempo's metrics-generator (service-graphs + span-metrics processors, tempo.yaml). Panels here are DOWN if a service isn't exporting OTLP traces to the otel-collector yet — see docs/consuming-repos/OBSERVABILITY_DASHBOARDS.md to wire an app up.",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {"collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}, "id": 1, "title": "RED (from span-metrics)", "type": "row"},
    {
      "datasource": {"type": "prometheus", "uid": "${prometheus_datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"fillOpacity": 10, "lineWidth": 1}, "unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 1},
      "id": 2,
      "options": {"legend": {"calcs": [], "displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "title": "Trace/Request Rate by Service",
      "type": "timeseries",
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "${prometheus_datasource}"},
        "expr": "sum by (service) (rate(traces_spanmetrics_calls_total{span_kind=\"SPAN_KIND_SERVER\", service=~\"$service\"}[$__interval]))",
        "legendFormat": "{{ service }}"
      }]
    },
    {
      "datasource": {"type": "prometheus", "uid": "${prometheus_datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"fillOpacity": 10, "lineWidth": 1}, "unit": "percentunit", "max": 1, "min": 0}, "overrides": []},
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 1},
      "id": 3,
      "options": {"legend": {"calcs": [], "displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "title": "Error Rate by Service",
      "type": "timeseries",
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "${prometheus_datasource}"},
        "expr": "sum by (service) (rate(traces_spanmetrics_calls_total{span_kind=\"SPAN_KIND_SERVER\", status_code=\"STATUS_CODE_ERROR\", service=~\"$service\"}[$__interval])) / sum by (service) (rate(traces_spanmetrics_calls_total{span_kind=\"SPAN_KIND_SERVER\", service=~\"$service\"}[$__interval]))",
        "legendFormat": "{{ service }}"
      }]
    },
    {
      "datasource": {"type": "prometheus", "uid": "${prometheus_datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"fillOpacity": 10, "lineWidth": 1}, "unit": "s"}, "overrides": []},
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 1},
      "id": 4,
      "options": {"legend": {"calcs": [], "displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "title": "p50 / p95 / p99 Duration (all services)",
      "type": "timeseries",
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${prometheus_datasource}"}, "expr": "histogram_quantile(0.50, sum(rate(traces_spanmetrics_latency_bucket{span_kind=\"SPAN_KIND_SERVER\", service=~\"$service\"}[$__interval])) by (le))", "legendFormat": "p50"},
        {"datasource": {"type": "prometheus", "uid": "${prometheus_datasource}"}, "expr": "histogram_quantile(0.95, sum(rate(traces_spanmetrics_latency_bucket{span_kind=\"SPAN_KIND_SERVER\", service=~\"$service\"}[$__interval])) by (le))", "legendFormat": "p95"},
        {"datasource": {"type": "prometheus", "uid": "${prometheus_datasource}"}, "expr": "histogram_quantile(0.99, sum(rate(traces_spanmetrics_latency_bucket{span_kind=\"SPAN_KIND_SERVER\", service=~\"$service\"}[$__interval])) by (le))", "legendFormat": "p99"}
      ]
    },

    {"collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 8}, "id": 10, "title": "Service graph", "type": "row"},
    {
      "datasource": {"type": "prometheus", "uid": "${prometheus_datasource}"},
      "description": "Approximates the service graph as a table (client -> server call rate + error rate). For the interactive node-graph view, open the Tempo datasource in Explore and select the 'Service Graph' tab — it is generated by Grafana from the same traces_service_graph_request_total series and is fragile to hand-author in a dashboard JSON.",
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 9},
      "id": 11,
      "options": {"showHeader": true},
      "title": "Service-to-Service Call Rate",
      "type": "table",
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "${prometheus_datasource}"},
        "expr": "sum by (client, server) (rate(traces_service_graph_request_total[$__range]))",
        "format": "table",
        "instant": true
      }]
    },

    {"collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 17}, "id": 20, "title": "Spans", "type": "row"},
    {
      "datasource": {"type": "prometheus", "uid": "${prometheus_datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"fillOpacity": 10, "lineWidth": 1}, "unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 18},
      "id": 21,
      "options": {"legend": {"calcs": [], "displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "title": "p95 Span Duration by Service",
      "type": "timeseries",
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "${prometheus_datasource}"},
        "expr": "histogram_quantile(0.95, sum by (le, service) (rate(traces_spanmetrics_latency_bucket{service=~\"$service\"}[$__interval])))",
        "legendFormat": "{{ service }}"
      }]
    },

    {"collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 26}, "id": 30, "title": "Trace search", "type": "row"},
    {
      "datasource": {"type": "tempo", "uid": "${tempo_datasource}"},
      "description": "TraceQL search. Narrow with e.g. {resource.service.name=\"my-api\" && status=error} — see https://grafana.com/docs/tempo/latest/traceql/",
      "fieldConfig": {"defaults": {}, "overrides": []},
      "gridPos": {"h": 12, "w": 24, "x": 0, "y": 27},
      "id": 31,
      "options": {},
      "title": "Traces",
      "type": "traces",
      "targets": [{
        "datasource": {"type": "tempo", "uid": "${tempo_datasource}"},
        "queryType": "traceql",
        "query": "{ .service.name =~ \"$service\" }",
        "limit": 50,
        "tableType": "traces"
      }]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["fuzeinfra", "tracing", "tempo"],
  "templating": {
    "list": [
      {"current": {}, "hide": 0, "includeAll": false, "label": "Prometheus", "multi": false, "name": "prometheus_datasource", "options": [], "query": "prometheus", "refresh": 1, "type": "datasource"},
      {"current": {}, "hide": 0, "includeAll": false, "label": "Tempo", "multi": false, "name": "tempo_datasource", "options": [], "query": "tempo", "refresh": 1, "type": "datasource"},
      {
        "current": {"selected": true, "text": ["All"], "value": ["$__all"]},
        "datasource": {"type": "prometheus", "uid": "${prometheus_datasource}"},
        "definition": "label_values(traces_spanmetrics_calls_total, service)",
        "hide": 0,
        "includeAll": true,
        "allValue": ".+",
        "label": "Service",
        "multi": true,
        "name": "service",
        "query": "label_values(traces_spanmetrics_calls_total, service)",
        "refresh": 2,
        "type": "query"
      }
    ]
  },
  "time": {"from": "now-3h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "Tracing",
  "uid": "fuzeinfra-tracing",
  "version": 1
}
