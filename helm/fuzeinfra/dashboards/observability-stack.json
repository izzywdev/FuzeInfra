{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {"collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}, "id": 1, "title": "Component Health", "type": "row"},
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}, "mappings": [{"type": "value", "options": {"0": {"text": "DOWN"}, "1": {"text": "UP"}}}], "unit": "none"}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 1},
      "id": 2,
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}, "textMode": "value_and_name"},
      "title": "Prometheus",
      "type": "stat",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "up{job=\"prometheus\"}", "instant": true, "legendFormat": ""}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}, "mappings": [{"type": "value", "options": {"0": {"text": "DOWN"}, "1": {"text": "UP"}}}], "unit": "none"}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 1},
      "id": 3,
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}, "textMode": "value_and_name"},
      "title": "Loki",
      "type": "stat",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "up{job=\"loki\"}", "instant": true, "legendFormat": ""}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}, "mappings": [{"type": "value", "options": {"0": {"text": "DOWN"}, "1": {"text": "UP"}}}], "unit": "none"}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 1},
      "id": 4,
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}, "textMode": "value_and_name"},
      "title": "Tempo",
      "type": "stat",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "up{job=\"tempo\"}", "instant": true, "legendFormat": ""}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}, "mappings": [{"type": "value", "options": {"0": {"text": "DOWN"}, "1": {"text": "UP"}}}], "unit": "none"}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 1},
      "id": 5,
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}, "textMode": "value_and_name"},
      "title": "OTel Collector",
      "type": "stat",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "up{job=\"otel-collector\"}", "instant": true, "legendFormat": ""}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Any job with at least one target failing to scrape. Drill into Status > Targets in Prometheus for the exact instance.",
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 5, "w": 24, "x": 0, "y": 5},
      "id": 6,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "horizontal", "displayMode": "gradient", "showUnfilled": true},
      "title": "Scrape Failures by Job",
      "type": "bargauge",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "count by (job) (up == 0)", "instant": true, "legendFormat": "{{ job }}"}]
    },

    {"collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 10}, "id": 10, "title": "Tempo (traces backend)", "type": "row"},
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"fillOpacity": 10, "lineWidth": 1}, "unit": "ops"}, "overrides": []},
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 11},
      "id": 11,
      "options": {"legend": {"calcs": [], "displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "title": "Spans Received/sec",
      "type": "timeseries",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum(rate(tempo_distributor_spans_received_total[$__interval]))", "legendFormat": "received"}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Spans dropped by Tempo itself — over storage/rate limits, bad batches, etc. Should be flat 0.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"fillOpacity": 10, "lineWidth": 1}, "unit": "ops"}, "overrides": []},
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 11},
      "id": 12,
      "options": {"legend": {"calcs": [], "displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "title": "Spans Dropped/sec",
      "type": "timeseries",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum by (reason) (rate(tempo_discarded_spans_total[$__interval]))", "legendFormat": "{{ reason }}"}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"fillOpacity": 10, "lineWidth": 1}, "unit": "By"}, "overrides": []},
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 18},
      "id": 13,
      "options": {"legend": {"calcs": [], "displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "title": "Ingester Bytes Received/sec",
      "type": "timeseries",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum(rate(tempo_ingester_bytes_received_total[$__interval]))", "legendFormat": "bytes"}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "GB", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 7}, {"color": "red", "value": 9}]}}, "overrides": []},
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 18},
      "id": 14,
      "options": {"colorMode": "background", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "title": "Trace Volume PVC Usage (fuzeinfra-tempo-data)",
      "type": "stat",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "max(kubelet_volume_stats_used_bytes{persistentvolumeclaim=\"fuzeinfra-tempo-data\"}) / 1e9", "instant": true, "legendFormat": ""}]
    },

    {"collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 25}, "id": 20, "title": "OTel Collector (ingestion)", "type": "row"},
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"fillOpacity": 10, "lineWidth": 1}, "unit": "ops"}, "overrides": []},
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 26},
      "id": 21,
      "options": {"legend": {"calcs": [], "displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "title": "Spans: accepted vs refused",
      "type": "timeseries",
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum(rate(otelcol_receiver_accepted_spans_total[$__interval]))", "legendFormat": "accepted"},
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum(rate(otelcol_receiver_refused_spans_total[$__interval]))", "legendFormat": "refused"},
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum(rate(otelcol_exporter_send_failed_spans_total[$__interval]))", "legendFormat": "export failed"}
      ]
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"fillOpacity": 10, "lineWidth": 1}, "unit": "ops"}, "overrides": []},
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 26},
      "id": 22,
      "options": {"legend": {"calcs": [], "displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "title": "Log records: accepted vs refused",
      "type": "timeseries",
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum(rate(otelcol_receiver_accepted_log_records_total[$__interval]))", "legendFormat": "accepted"},
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum(rate(otelcol_receiver_refused_log_records_total[$__interval]))", "legendFormat": "refused"},
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum(rate(otelcol_exporter_send_failed_log_records_total[$__interval]))", "legendFormat": "export failed"}
      ]
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"fillOpacity": 10, "lineWidth": 1}, "unit": "ops"}, "overrides": []},
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 26},
      "id": 23,
      "options": {"legend": {"calcs": [], "displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "title": "Metric points: accepted vs refused",
      "type": "timeseries",
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum(rate(otelcol_receiver_accepted_metric_points_total[$__interval]))", "legendFormat": "accepted"},
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum(rate(otelcol_receiver_refused_metric_points_total[$__interval]))", "legendFormat": "refused"},
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum(rate(otelcol_exporter_send_failed_metric_points_total[$__interval]))", "legendFormat": "export failed"}
      ]
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "otelcol_processor_dropped_spans/logs/metric_points come from the memory_limiter processor shedding load — a sustained rise means the collector needs more memory (otelCollector.resources) or replicas (otelCollector.replicas).",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"fillOpacity": 10, "lineWidth": 1}, "unit": "ops"}, "overrides": []},
      "gridPos": {"h": 7, "w": 24, "x": 0, "y": 33},
      "id": 24,
      "options": {"legend": {"calcs": [], "displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "title": "Processor Dropped (memory_limiter shedding)",
      "type": "timeseries",
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum(rate(otelcol_processor_dropped_spans_total[$__interval]))", "legendFormat": "spans"},
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum(rate(otelcol_processor_dropped_log_records_total[$__interval]))", "legendFormat": "logs"},
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum(rate(otelcol_processor_dropped_metric_points_total[$__interval]))", "legendFormat": "metric points"}
      ]
    },

    {"collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 40}, "id": 30, "title": "Prometheus & Loki self-health", "type": "row"},
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"fillOpacity": 10, "lineWidth": 1}, "unit": "percentunit"}, "overrides": []},
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 41},
      "id": 31,
      "options": {"legend": {"calcs": [], "displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "title": "Prometheus TSDB Head Series (fraction of last 24h max)",
      "type": "timeseries",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "prometheus_tsdb_head_series / max_over_time(prometheus_tsdb_head_series[24h])", "legendFormat": "head series"}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"fillOpacity": 10, "lineWidth": 1}, "unit": "ops"}, "overrides": []},
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 41},
      "id": 32,
      "options": {"legend": {"calcs": [], "displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "title": "Loki 5xx Rate",
      "type": "timeseries",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum(rate(loki_request_duration_seconds_count{status_code=~\"5..\"}[$__interval]))", "legendFormat": "5xx"}]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["fuzeinfra", "observability", "platform"],
  "templating": {
    "list": [
      {"current": {}, "hide": 0, "includeAll": false, "label": "Datasource", "multi": false, "name": "datasource", "options": [], "query": "prometheus", "refresh": 1, "type": "datasource"}
    ]
  },
  "time": {"from": "now-6h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "Observability Stack Health",
  "uid": "fuzeinfra-observability-stack",
  "version": 1
}
