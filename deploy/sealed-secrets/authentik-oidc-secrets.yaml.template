# =============================================================================
# PLACEHOLDER / TEMPLATE — Authentik OIDC client secrets for the admin plane.
#
# This is a *.template file on purpose: it is NOT a real SealedSecret and is NOT
# synced by Argo (the fuzeinfra-sealed-secrets Application recurses
# deploy/sealed-secrets/ for *.yaml; a `.template` suffix is excluded). It exists
# so the credential-wiring path is committed and reviewable WITHOUT ever
# committing real values.
#
# ── What these are ───────────────────────────────────────────────────────────
# Four OIDC client secrets that let the FuzeInfra admin plane authenticate
# against Authentik (auth.fuzefront.com) instead of each service carrying its
# own local password. Each secret exists on BOTH sides of an OIDC handshake:
#
#   client            IdP side (issuer)                  consumer side (relying party)
#   ----------------  ---------------------------------  --------------------------------
#   cloudflare-access fuzefront/fuzefront-secrets         GitHub Actions secret
#                     key CF_ACCESS_CLIENT_SECRET         AUTHENTIK_CF_ACCESS_CLIENT_SECRET
#                                                         (read by Terraform as
#                                                         TF_VAR_authentik_access_client_secret)
#   grafana           fuzefront/fuzefront-secrets         fuzeinfra/grafana-oidc
#                     key GRAFANA_CLIENT_SECRET           key CLIENT_SECRET
#   argocd            fuzefront/fuzefront-secrets         argocd/argocd-oidc
#                     key ARGOCD_CLIENT_SECRET            key clientSecret
#   kafka-ui          fuzefront/fuzefront-secrets         fuzeinfra/kafka-ui-oidc
#                     key KAFKA_UI_CLIENT_SECRET          key CLIENT_SECRET
#
# THE TWO SIDES MUST CARRY THE SAME VALUE. A SealedSecret only decrypts under
# the exact namespace + name it was sealed for, so the same plaintext has to be
# sealed twice — once for `fuzefront` (where Authentik's blueprint runner reads
# it via !Env) and once for the consumer's namespace. This is the documented
# cross-namespace double-seal pattern; see helm/fuzeinfra/values.yaml.
#
# The IdP side lives in izzywdev/FuzeFront:
#   deploy/helm/fuzefront/authentik/blueprints/provider-oidc-fuzeinfra-admin.yaml
#   deploy/contabo/sealed/fuzefront-secrets.yaml
#
# ── Minting the values (human, one-time, offline) ────────────────────────────
# These are NOT provider keys — they are secrets you generate. Write each to a
# throwaway file (keeps plaintext out of shell history and argv):
#
#   for k in cf_access grafana argocd kafka_ui; do
#     openssl rand -hex 48 > "/tmp/ak_$k"
#   done
#
# 1) Seal the IdP side into FuzeFront's namespace. Pointing --out at the
#    EXISTING fuzefront-secrets manifest merges the new keys in (kubeseal
#    --merge-into) rather than replacing it — the other keys already in that
#    file (AUTHENTIK_SECRET_KEY, DB_PASSWORD, ...) are preserved:
#
#   scripts/seal-secret.sh fuzefront/fuzefront-secrets \
#     CF_ACCESS_CLIENT_SECRET=@/tmp/ak_cf_access \
#     GRAFANA_CLIENT_SECRET=@/tmp/ak_grafana \
#     ARGOCD_CLIENT_SECRET=@/tmp/ak_argocd \
#     KAFKA_UI_CLIENT_SECRET=@/tmp/ak_kafka_ui \
#     --out <FuzeFront>/deploy/contabo/sealed/fuzefront-secrets.yaml
#
# 2) Seal the consumer side into this repo:
#
#   scripts/seal-secret.sh fuzeinfra/grafana-oidc \
#     CLIENT_SECRET=@/tmp/ak_grafana \
#     --out deploy/sealed-secrets/grafana-oidc.yaml
#
#   scripts/seal-secret.sh fuzeinfra/kafka-ui-oidc \
#     CLIENT_SECRET=@/tmp/ak_kafka_ui \
#     --out deploy/sealed-secrets/kafka-ui-oidc.yaml
#
#   # NOTE the namespace: argocd, not fuzeinfra. ArgoCD reads
#   # `$argocd-oidc:clientSecret` from a Secret in its OWN namespace, and the
#   # key name is camelCase because that is the literal token argocd-cm
#   # dereferences.
#   scripts/seal-secret.sh argocd/argocd-oidc \
#     clientSecret=@/tmp/ak_argocd \
#     --out deploy/sealed-secrets/argocd-oidc.yaml
#
# 3) Set the Cloudflare Access one as a GitHub Actions secret on THIS repo, so
#    Terraform can create the Access identity provider:
#
#   gh secret set AUTHENTIK_CF_ACCESS_CLIENT_SECRET < /tmp/ak_cf_access
#
#    DO THIS BEFORE MERGING the Terraform PR. The resource is count-gated on the
#    variable being non-empty, so an unwired secret plans a DESTROY of the Access
#    identity provider and its policies — the same trap already documented for
#    crit_bridge_token in terraform/contabo/cloudflare.tf.
#
# 4)  shred -u /tmp/ak_cf_access /tmp/ak_grafana /tmp/ak_argocd /tmp/ak_kafka_ui
#
# ── Ordering ─────────────────────────────────────────────────────────────────
# Seal the IdP side FIRST and let Argo sync it before Authentik creates the
# providers. The Authentik 2024.x blueprint runner honours client_secret only at
# CREATION time: if a provider is created while the key is absent it is stamped
# with an empty secret, and sealing the value later does NOT update it. Recovery
# is to delete the provider entry in Authentik and re-apply the blueprint.
#
# In the SAME commit that lands each real sealed file, flip its consumer gate:
#   helm/fuzeinfra/values-contabo.yaml -> grafana.oidc.enabled: true
#   helm/fuzeinfra/values-contabo.yaml -> kafkaUi.oidc.enabled: true
# Enabling before the Secret exists yields CreateContainerConfigError.
#
# ── Rotation ─────────────────────────────────────────────────────────────────
# Rotating one side only breaks the handshake. A rotation is: delete the
# Authentik provider entry, re-seal BOTH sides with the new value, update the
# GitHub secret if it is the Cloudflare one, and merge all PRs together.
#
# ── Shape of the REAL sealed output (for reference only) ─────────────────────
# apiVersion: bitnami.com/v1alpha1
# kind: SealedSecret
# metadata:
#   name: grafana-oidc
#   namespace: fuzeinfra
# spec:
#   encryptedData:
#     CLIENT_SECRET: AgB...   # ciphertext, safe to commit
#   template:
#     metadata:
#       name: grafana-oidc
#       namespace: fuzeinfra
#     type: Opaque
# =============================================================================
