# =============================================================================
# PLACEHOLDER / TEMPLATE — A2A delivery gateway credentials.
#
# *.template = NOT a real SealedSecret, NOT synced by Argo. Commits the wiring path
# without a real secret. The gateway is OFF (a2aGateway.enabled=false) until the real
# deploy/sealed-secrets/a2a-gateway-secret.yaml exists AND the value is flipped on in
# the SAME change (handoffMcp precedent).
#
# ── Keys this Secret must carry ──────────────────────────────────────────────
#   .credentials.json     A Claude.ai ACCOUNT login (NOT an API key — `--cloud`
#                         rejects API keys). Produce it on a machine:
#                           claude auth login --claudeai       # completes browser OAuth
#                           cat ~/.claude/.credentials.json    # this file's contents
#                         The gateway copies it to a writable ~/.claude and the claude
#                         CLI uses it to run `claude -p --cloud <id>`. This credential
#                         is the user's Claude.ai identity — the gateway acts AS them,
#                         and every delivered message spends that account's usage.
#                         When the OAuth refresh token eventually rotates, re-seal.
#
#   FUZE_A2A_GATEWAY_TOKEN Bearer the gateway enforces on /register and /send when set
#                         (v0 runs OPEN if unset). Alphanumeric, no trailing newline.
#                         The same value goes to caller sessions as FUZE_A2A_GATEWAY_TOKEN.
#
# ── Produce the real sealed file (offline, no cluster access) ─────────────────
#   claude auth login --claudeai              # on a trusted machine
#   cp ~/.claude/.credentials.json /tmp/gwcreds.json
#   printf %s "$(LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 48)" > /tmp/gwtoken
#   scripts/seal-secret.sh fuzeinfra/a2a-gateway-secret \
#     .credentials.json=@/tmp/gwcreds.json \
#     FUZE_A2A_GATEWAY_TOKEN=@/tmp/gwtoken \
#     --out deploy/sealed-secrets/a2a-gateway-secret.yaml
#   shred -u /tmp/gwcreds.json /tmp/gwtoken
# (If kubeseal.exe is blocked locally, use the bitnami container — see
#  handoff-mcp-secret.yaml.template.)
#
# ── ROTATION: in the SAME commit as the reseal, bump ─────────────────────────
#   helm/fuzeinfra/values.yaml (or overlay) -> a2aGateway.secretRotation
#
# ── Shape of the REAL sealed output (reference only) ─────────────────────────
# apiVersion: bitnami.com/v1alpha1
# kind: SealedSecret
# metadata: { name: a2a-gateway-secret, namespace: fuzeinfra }
# spec:
#   encryptedData:
#     .credentials.json:     AgB...   # ciphertext, safe to commit
#     FUZE_A2A_GATEWAY_TOKEN: AgC...
#   template:
#     metadata: { name: a2a-gateway-secret, namespace: fuzeinfra }
#     type: Opaque
# =============================================================================
