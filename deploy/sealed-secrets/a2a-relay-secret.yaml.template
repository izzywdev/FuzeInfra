# =============================================================================
# PLACEHOLDER / TEMPLATE — A2A WSS relay bearer (OPTIONAL; not used in v0).
#
# This is a *.template on purpose: NOT a real SealedSecret and NOT synced by Argo
# (the sealed-secrets Application recurses deploy/sealed-secrets/ for *.yaml; the
# `.template` suffix is excluded). It commits the wiring path without a real secret.
#
# The relay ships in v0 OPEN mode: no bearer, the capability is the unguessable
# cse_... session-id, and reachability comes from the CF Access bypass on
# relay.<domain>. The relay Deployment references a2a-relay-secret with
# `optional: true`, so NO Secret is required for v0.
#
# ── When you HARDEN (FuzeAgent / FuzeSDLC#219) ───────────────────────────────
#   FUZE_A2A_RELAY_TOKEN   The shared bearer the relay enforces when set (relay.py
#                          rejects clients whose ?token= doesn't match). Give the
#                          SAME value to each session's bridge as the
#                          FUZE_A2A_RELAY_TOKEN env in the DevOps cloud environment.
#                          Better still, replace the shared bearer with per-session
#                          minted tokens tied to the agent machine identity.
#                          Alphanumeric only, NO trailing newline.
#
# ── Produce the real file (offline, no cluster access) ───────────────────────
#   printf %s "$(LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 48)" > /tmp/relay_token
#   scripts/seal-secret.sh fuzeinfra/a2a-relay-secret \
#     FUZE_A2A_RELAY_TOKEN=@/tmp/relay_token \
#     --out deploy/sealed-secrets/a2a-relay-secret.yaml
#   shred -u /tmp/relay_token
#
# seal-secret.sh falls back to the committed public cert
# (deploy/sealed-secrets/sealing-cert.pem) since the cert endpoint is behind CF
# Access. If kubeseal.exe is blocked locally, run it via the bitnami container (see
# handoff-mcp-secret.yaml.template for the exact docker line).
#
# ── ROTATION: in the SAME commit as the reseal, bump ─────────────────────────
#   helm/fuzeinfra/values-contabo.yaml -> a2aRelay.secretRotation
# (feeds checksum/relay-secret; without it the pod keeps the OLD token — the #589
# kafka-ui failure mode).
#
# ── Shape of the REAL sealed output (reference only) ─────────────────────────
# apiVersion: bitnami.com/v1alpha1
# kind: SealedSecret
# metadata: { name: a2a-relay-secret, namespace: fuzeinfra }
# spec:
#   encryptedData:
#     FUZE_A2A_RELAY_TOKEN: AgB...   # ciphertext, safe to commit
#   template:
#     metadata: { name: a2a-relay-secret, namespace: fuzeinfra }
#     type: Opaque
# =============================================================================
