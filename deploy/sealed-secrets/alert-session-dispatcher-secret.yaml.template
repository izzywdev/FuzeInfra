# =============================================================================
# PLACEHOLDER / TEMPLATE -- alert -> agent-session dispatcher secrets.
#
# A *.template on purpose: NOT a SealedSecret and NOT synced by Argo (the
# sealed-secrets Application recurses deploy/sealed-secrets/ for *.yaml). It commits
# the wiring path, never a value. Nothing here is sealed and no value exists in git.
#
# There is deliberately NO FuzeFront credential in this Secret. The dispatcher
# authenticates to FuzeFront with its projected ServiceAccount token (audience
# fuzefront-security) and receives a <=5 minute workload token per dispatch, so there
# is no long-lived bootstrap secret to leak or rotate. (The brief suggested a sealed
# bootstrap credential; FuzeFront's POST /tokens/workload makes it unnecessary.)
#
# Keys (Secret name: alert-session-dispatcher-secret, namespace: fuzeinfra):
#   ALERT_DISPATCH_INBOUND_TOKEN  REQUIRED. Bearer Grafana presents to the dispatcher.
#                                 Random, alphanumeric only, no trailing newline.
#   GITHUB_AUDIT_TOKEN            OPTIONAL. Fine-grained token with Issues:write on
#                                 izzywdev/FuzeInfra ONLY. Absent -> audit is the
#                                 structured log (Loki) only. Never a classic PAT.
#
# -- Produce the real file (offline, no cluster access) -----------------------
#   printf %s "$(LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 48)" > /tmp/inbound
#   scripts/seal-secret.sh fuzeinfra/alert-session-dispatcher-secret \
#     ALERT_DISPATCH_INBOUND_TOKEN=@/tmp/inbound \
#     --out deploy/sealed-secrets/alert-session-dispatcher-secret.yaml
#   shred -u /tmp/inbound
#
# ROTATION: bump helm/fuzeinfra/values-contabo.yaml -> alertSessionDispatcher.secretRotation
# in the SAME commit as the reseal. Grafana reads the same key as an env var, so
# also roll Grafana (its pod template changes only when its env does).
#
# -- Shape of the REAL sealed output (reference only) -------------------------
# apiVersion: bitnami.com/v1alpha1
# kind: SealedSecret
# metadata: { name: alert-session-dispatcher-secret, namespace: fuzeinfra }
# spec:
#   encryptedData:
#     ALERT_DISPATCH_INBOUND_TOKEN: AgB...   # ciphertext, safe to commit
#   template:
#     metadata: { name: alert-session-dispatcher-secret, namespace: fuzeinfra }
#     type: Opaque
# =============================================================================
