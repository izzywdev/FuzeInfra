# =============================================================================
# PLACEHOLDER / TEMPLATE — LiteLLM gateway credentials.
#
# This is a *.template file on purpose: it is NOT a real SealedSecret and is NOT
# synced by Argo (the fuzeinfra-sealed-secrets Application recurses
# deploy/sealed-secrets/ for *.yaml; a `.template` suffix is excluded). It exists
# so the credential-wiring path is committed and reviewable WITHOUT ever
# committing real provider keys.
#
# ── Keys this Secret must carry ──────────────────────────────────────────────
#   LITELLM_MASTER_KEY   The bearer token every consumer sends to the gateway.
#                        MUST begin with the literal prefix `sk-` — LiteLLM
#                        rejects a master key without it at startup. Generate a
#                        fresh random one; it is not a provider key:
#                          printf 'sk-%s' "$(openssl rand -hex 32)"
#   ANTHROPIC_API_KEY    Console -> API Keys. Serves the claude-* chat models.
#   OPENAI_API_KEY       Serves text-embedding-3-small. REQUIRED FOR /embeddings:
#                        Anthropic ships no embeddings endpoint, so an
#                        Anthropic-only gateway cannot answer /embeddings at all.
#                        Omit it and chat still works; the doc indexer will 401.
#
# ── How to produce the real file (human, one-time, offline) ──────────────────
# Write each value to a throwaway file (keeps plaintext out of shell history and
# argv), seal OFFLINE against FuzeInfra's published public cert — zero cluster
# access needed, the cert is encrypt-only — and write the real manifest NEXT TO
# this template:
#
#   printf 'sk-%s' "$(openssl rand -hex 32)" > /tmp/litellm_master
#   printf %s '<ANTHROPIC_API_KEY>'          > /tmp/litellm_anthropic
#   printf %s '<OPENAI_API_KEY>'             > /tmp/litellm_openai
#   scripts/seal-secret.sh fuzeinfra/litellm-secret \
#     LITELLM_MASTER_KEY=@/tmp/litellm_master \
#     ANTHROPIC_API_KEY=@/tmp/litellm_anthropic \
#     OPENAI_API_KEY=@/tmp/litellm_openai \
#     --out deploy/sealed-secrets/litellm-secret.yaml
#   shred -u /tmp/litellm_master /tmp/litellm_anthropic /tmp/litellm_openai
#
# Keep /tmp/litellm_master until you have also sealed the SAME value into
# FuzeFront's namespace (see "Handing the master key to a consumer" below).
#
# Commit ONLY the resulting deploy/sealed-secrets/litellm-secret.yaml
# (encrypted). Argo's fuzeinfra-sealed-secrets app self-heals it onto the
# cluster and the sealed-secrets controller decrypts it into the
# `litellm-secret` Secret in the `fuzeinfra` namespace.
#
# IN THE SAME COMMIT, flip helm/litellm/values-contabo.yaml -> enabled: true.
# Enabling before this Secret exists CrashLoops the pod with
# CreateContainerConfigError.
#
# ── Handing the master key to a consumer ─────────────────────────────────────
# The scope is STRICT: a SealedSecret only decrypts under the exact namespace +
# name it was sealed for. FuzeFront cannot read `fuzeinfra/litellm-secret`, so
# seal the same master-key value a SECOND time for their namespace. They commit
# that file in their own repo; the plaintext never leaves your machine:
#
#   scripts/seal-secret.sh fuzefront/chat-service-secrets \
#     LITELLM_MASTER_KEY=@/tmp/litellm_master \
#     --out /tmp/fuzefront-litellm-sealed.yaml
#
# Rotation = re-seal BOTH files with the new value and merge both PRs. Rotating
# only the gateway side 401s every consumer.
#
# ── Shape of the REAL sealed output (for reference only) ─────────────────────
# apiVersion: bitnami.com/v1alpha1
# kind: SealedSecret
# metadata:
#   name: litellm-secret
#   namespace: fuzeinfra
# spec:
#   encryptedData:
#     LITELLM_MASTER_KEY: AgB...   # ciphertext, safe to commit
#     ANTHROPIC_API_KEY:  AgC...
#     OPENAI_API_KEY:     AgD...
#   template:
#     metadata:
#       name: litellm-secret
#       namespace: fuzeinfra
#     type: Opaque
# =============================================================================
