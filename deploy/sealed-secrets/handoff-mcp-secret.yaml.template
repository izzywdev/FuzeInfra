# =============================================================================
# PLACEHOLDER / TEMPLATE — handoff MCP server credentials.
#
# This is a *.template file on purpose: it is NOT a real SealedSecret and is NOT
# synced by Argo (the fuzeinfra-sealed-secrets Application recurses
# deploy/sealed-secrets/ for *.yaml; a `.template` suffix is excluded). It exists
# so the credential-wiring path is committed and reviewable WITHOUT ever
# committing a real provider key. The real, encrypted file lives next to it at
# deploy/sealed-secrets/handoff-mcp-secret.yaml (landed by #587).
#
# ── Keys this Secret must carry ──────────────────────────────────────────────
#   ANTHROPIC_API_KEY   Read by agent-templates/sync/common.py::_api_key() and
#                       sent as `x-api-key` on every Managed Agents call the
#                       server makes on an agent's behalf.
#
#                       IT MUST BE A MANAGED-AGENTS-ENTITLED CONSOLE KEY — the
#                       same class of key as the MANAGED_AGENTS_API_KEY Actions
#                       secret, NOT a Claude Code token and not any Console key.
#                       common.py sends `anthropic-beta: managed-agents-2026-04-01`
#                       (see MANAGED_AGENTS_BETA); a key without that entitlement
#                       authenticates and then 4xxs on the first spawn_agent,
#                       which surfaces as a tool error at call time, never at
#                       startup. The env var NAME is fixed by the code; the VALUE
#                       is the managed-agents key. Those two are easy to conflate
#                       because the repo carries both under different names.
#
#                       The account behind this key must also have CREDIT. As of
#                       2026-08-20 the fleet's provisioning fails with HTTP 400
#                       "Your credit balance is too low to access the Anthropic
#                       API" (run 32322608863) — the same account, the same
#                       failure this server will hit on every tool call.
#
#   HANDOFF_MCP_TOKEN   The bearer the server itself enforces (server.py checks it
#                       when set; if UNSET the MCP is fully UNAUTHENTICATED and
#                       merely prints a warning to stderr — so it is never
#                       optional in prod). This is the ONLY authentication in
#                       front of an endpoint that spends your Anthropic credit,
#                       because the CF Access app on mcp-handoff.<domain> is a
#                       deliberate `bypass` for machine callers. Generate a fresh
#                       random one; it is not a provider key. Alphanumeric only
#                       and NO trailing newline — a shell metacharacter in a
#                       generated secret has broken airflow-init here before, and
#                       a trailing \n silently becomes part of the bearer.
#
#                       The same value must be given to the agents that call this
#                       server, as the HANDOFF_MCP_TOKEN Actions secret and as the
#                       vault credential keyed to HANDOFF_MCP_URL. Rotating one
#                       side only makes every handoff 401.
#
# ── How to produce the real file (human, one-time, offline) ──────────────────
# Write each value to a throwaway file (keeps plaintext out of shell history and
# argv) and seal OFFLINE against FuzeInfra's published public cert — zero cluster
# access needed, the cert encrypts only:
#
#   printf %s "$(LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 48)" > /tmp/handoff_token
#   printf %s '<MANAGED-AGENTS-ENTITLED CONSOLE KEY>'                     > /tmp/handoff_key
#   scripts/seal-secret.sh fuzeinfra/handoff-mcp-secret \
#     ANTHROPIC_API_KEY=@/tmp/handoff_key \
#     HANDOFF_MCP_TOKEN=@/tmp/handoff_token \
#     --out deploy/sealed-secrets/handoff-mcp-secret.yaml
#   shred -u /tmp/handoff_key /tmp/handoff_token
#
# `printf %s` is load-bearing: `echo` would append the newline described above.
#
# If kubeseal is unavailable locally (Windows Smart App Control blocks the
# signed-but-unknown kubeseal.exe on at least one dev machine), run it as a
# container against the committed cert — sealing needs no cluster and no daemon
# access beyond docker itself:
#
#   MSYS_NO_PATHCONV=1 docker run --rm -i -v "$PWD/deploy/sealed-secrets:/w" \
#     docker.io/bitnami/sealed-secrets-kubeseal:latest \
#     --scope strict --format yaml --cert /w/sealing-cert.pem < secret.yaml
#
# The published cert (https://sealed-secrets.prod.fuzefront.com/v1/cert.pem) sits
# behind CF Access, so seal-secret.sh falls back to the committed public copy at
# deploy/sealed-secrets/sealing-cert.pem. Refresh that file after a controller key
# rotation, or the SealedSecret will be sealed to a key the controller no longer
# holds and will never decrypt.
#
# ── ROTATION IS ONLY HALF DONE WHEN THE RESEAL MERGES ────────────────────────
# In the SAME commit as the resealed manifest, bump:
#
#   helm/fuzeinfra/values.yaml (or the overlay) -> handoffMcp.secretRotation
#
# That value feeds the `checksum/handoff-secret` pod annotation. It exists because
# this chart CANNOT hash the secret: the SealedSecret is ciphertext that Argo
# applies from outside the release, so its content is invisible to the template —
# and Kubernetes does not restart a pod when a Secret it consumed as env changes.
# Reseal without the bump and the pod keeps serving the OLD key indefinitely, with
# nothing anywhere reporting a problem. This is exactly how kafka-ui ended up
# authenticating with a stale secret after its "successful" rotation (#589).
#
# ── Shape of the REAL sealed output (for reference only) ─────────────────────
# apiVersion: bitnami.com/v1alpha1
# kind: SealedSecret
# metadata:
#   name: handoff-mcp-secret
#   namespace: fuzeinfra
# spec:
#   encryptedData:
#     ANTHROPIC_API_KEY: AgB...   # ciphertext, safe to commit
#     HANDOFF_MCP_TOKEN: AgC...
#   template:
#     metadata:
#       name: handoff-mcp-secret
#       namespace: fuzeinfra
#     type: Opaque
# =============================================================================
