# =============================================================================
# PLACEHOLDER / TEMPLATE — Contabo API credentials for the API floating-VIP
# keepalived DaemonSet (helm/fuzeinfra/templates/api-vip-keepalived.yaml).
#
# This is a *.template on purpose: NOT a real SealedSecret and NOT synced by Argo
# (the fuzeinfra-sealed-secrets Application globs *.yaml/*.yml/*.json; the
# `.template` suffix is excluded). It commits the credential-wiring path for review
# WITHOUT ever committing real secrets.
#
# ── WHY A SEPARATE COPY FROM THE AUTOSCALER ──────────────────────────────────
# The cluster-autoscaler already holds these same four Contabo API credentials,
# but in ITS namespace. A pod cannot read a Secret in another namespace, so the
# keepalived DaemonSet (namespace fuzeinfra) gets its own sealed copy of the SAME
# values. Rotating the Contabo credential means resealing BOTH.
#
# ── KEYS ─────────────────────────────────────────────────────────────────────
#   CONTABO_CLIENT_ID       Contabo OAuth2 client id      (autoscaler already uses)
#   CONTABO_CLIENT_SECRET   Contabo OAuth2 client secret
#   CONTABO_API_USER        Contabo API username
#   CONTABO_API_PASSWORD    Contabo API password
#   KEEPALIVED_AUTH_PASS    VRRP shared secret — generate fresh, not a Contabo
#                           value: `openssl rand -hex 8` (keepalived truncates
#                           auth_pass to 8 chars). Same value on all 3 nodes; it
#                           only authenticates VRRP peers to each other.
#
# The four Contabo values live in terraform/contabo/terraform.tfvars (gitignored)
# and the infra platform secrets — never commit them.
#
# ── Produce the real file (offline, no cluster access) ───────────────────────
#   printf %s '<CLIENT_ID>'      > /tmp/c_id
#   printf %s '<CLIENT_SECRET>'  > /tmp/c_sec
#   printf %s '<API_USER>'       > /tmp/c_user
#   printf %s '<API_PASSWORD>'   > /tmp/c_pass
#   openssl rand -hex 8          > /tmp/c_vrrp
#   scripts/seal-secret.sh fuzeinfra/contabo-api-credentials \
#     CONTABO_CLIENT_ID=@/tmp/c_id \
#     CONTABO_CLIENT_SECRET=@/tmp/c_sec \
#     CONTABO_API_USER=@/tmp/c_user \
#     CONTABO_API_PASSWORD=@/tmp/c_pass \
#     KEEPALIVED_AUTH_PASS=@/tmp/c_vrrp \
#     --out deploy/sealed-secrets/contabo-api-credentials.yaml
#   shred -u /tmp/c_id /tmp/c_sec /tmp/c_user /tmp/c_pass /tmp/c_vrrp
#
# Commit ONLY the encrypted deploy/sealed-secrets/contabo-api-credentials.yaml.
# Argo's fuzeinfra-sealed-secrets app syncs it; the controller decrypts it into
# the `contabo-api-credentials` Secret that api-vip-keepalived.yaml reads.
#
# ── Shape of the REAL sealed output (reference only) ─────────────────────────
# apiVersion: bitnami.com/v1alpha1
# kind: SealedSecret
# metadata:
#   name: contabo-api-credentials
#   namespace: fuzeinfra
# spec:
#   encryptedData:
#     CONTABO_CLIENT_ID: <AgB...>
#     CONTABO_CLIENT_SECRET: <AgB...>
#     CONTABO_API_USER: <AgB...>
#     CONTABO_API_PASSWORD: <AgB...>
#     KEEPALIVED_AUTH_PASS: <AgB...>
#   template:
#     metadata:
#       name: contabo-api-credentials
#       namespace: fuzeinfra
#     type: Opaque
# =============================================================================
