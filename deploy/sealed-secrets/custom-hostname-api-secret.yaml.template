# =============================================================================
# PLACEHOLDER / TEMPLATE — Custom Hostname API credentials.
#
# This is a *.template file on purpose: it is NOT a real SealedSecret and is NOT
# synced by Argo (the fuzeinfra-sealed-secrets Application globs *.yaml/*.yml/
# *.json under deploy/sealed-secrets/ with recurse; a `.template` suffix is
# excluded). It exists so the credential-wiring path is committed and reviewable
# WITHOUT ever committing real keys.
#
# Consumed by helm/fuzeinfra/templates/custom-hostname-api.yaml via
# customHostnameApi.secretName. See docs/consuming-repos/CUSTOM_DOMAINS.md.
#
# ── Keys ─────────────────────────────────────────────────────────────────────
#   CLOUDFLARE_API_TOKEN       Scoped Cloudflare API token (see below).
#   CLOUDFLARE_ZONE_ID         Zone ID for fuzefront.com (zone overview page).
#   CONSUMER_TOKEN_FUZEFRONT   Bearer token FuzeFront presents to this API. One
#                              key per enabled route profile, named
#                              CONSUMER_TOKEN_<PROFILE_NAME_UPPERCASED>.
#
# ── Cloudflare API token scope (least privilege — do NOT use a global key) ───
# Create at https://dash.cloudflare.com/profile/api-tokens with a Custom Token:
#   Permissions:
#     Zone -> SSL and Certificates -> Edit     (create/read/delete custom hostnames)
#     Zone -> Zone                -> Read      (resolve the zone)
#   Zone Resources:
#     Include -> Specific zone -> fuzefront.com
# That is the whole blast radius: the token cannot touch DNS records, Workers,
# Access policies, the tunnel, other zones, or the account. The DNS records this
# feature needs are created once by Terraform under a separate token, not by the
# service.
#
# ── How to produce the real file (human, one-time, offline) ─────────────────
# Generate the consumer token with a CSPRNG; give the SAME value to FuzeFront
# (sealed into the fuzefront namespace under whatever key its chart expects).
#
#   printf %s "$(openssl rand -hex 32)"  > /tmp/chapi_consumer
#   printf %s '<CLOUDFLARE_API_TOKEN>'   > /tmp/chapi_cf_token
#   printf %s '<CLOUDFLARE_ZONE_ID>'     > /tmp/chapi_zone
#
#   # (a) for FuzeInfra — the service side
#   scripts/seal-secret.sh fuzeinfra/custom-hostname-api-secret \
#     CLOUDFLARE_API_TOKEN=@/tmp/chapi_cf_token \
#     CLOUDFLARE_ZONE_ID=@/tmp/chapi_zone \
#     CONSUMER_TOKEN_FUZEFRONT=@/tmp/chapi_consumer \
#     --out deploy/sealed-secrets/custom-hostname-api-secret.yaml
#
#   # (b) for FuzeFront — the caller side (sealed into ITS namespace, in ITS repo)
#   scripts/seal-secret.sh fuzefront/custom-hostname-api-client \
#     CUSTOM_HOSTNAME_API_TOKEN=@/tmp/chapi_consumer \
#     --out /tmp/fuzefront-chapi-client.yaml
#
#   shred -u /tmp/chapi_consumer /tmp/chapi_cf_token /tmp/chapi_zone
#
# Commit ONLY deploy/sealed-secrets/custom-hostname-api-secret.yaml (encrypted).
# Hand (b) to FuzeFront to commit in its own repo — FuzeInfra never holds a
# consumer's namespace manifests, and the consumer never holds the Cloudflare
# token.
#
# ── Rotation ────────────────────────────────────────────────────────────────
# Re-seal both sides with a new consumer token in the SAME change; the API reads
# the token from the environment at startup, so the rollout is a pod restart on
# each side. Rotating the Cloudflare token is FuzeInfra-only and invisible to
# consumers. Existing custom hostnames are unaffected by either rotation — the
# certificates live at the Cloudflare edge, not in this Secret.
#
# ── GitOps gate ─────────────────────────────────────────────────────────────
# Land the real sealed file in the SAME change that sets
# customHostnameApi.enabled=true in helm/fuzeinfra/values-contabo.yaml.
# Enabling first CrashLoops the pod (CreateContainerConfigError).
#
# ── Shape of the REAL sealed output (for reference only) ────────────────────
# apiVersion: bitnami.com/v1alpha1
# kind: SealedSecret
# metadata:
#   name: custom-hostname-api-secret
#   namespace: fuzeinfra
# spec:
#   encryptedData:
#     CLOUDFLARE_API_TOKEN: <AgB...encrypted...>
#     CLOUDFLARE_ZONE_ID: <AgB...encrypted...>
#     CONSUMER_TOKEN_FUZEFRONT: <AgB...encrypted...>
#   template:
#     metadata:
#       name: custom-hostname-api-secret
#       namespace: fuzeinfra
#     type: Opaque
# =============================================================================
