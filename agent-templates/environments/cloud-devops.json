{
  "$schema": "../schema/environment.schema.json",
  "name": "fuzeinfra-cloud-devops",
  "config": {
    "type": "cloud",
    "packages": {
      "apt": ["gh"],
      "go": [
        "github.com/yannh/kubeconform/cmd/kubeconform@latest",
        "github.com/bitnami-labs/sealed-secrets/cmd/kubeseal@latest"
      ],
      "pip": ["yamllint", "check-jsonschema", "pyyaml", "mcp>=1.9,<2", "websockets"]
    },
    "networking": {
      "type": "limited",
      "allowed_hosts": ["get.helm.sh", "github.com", "*.fuzefront.com", "*.cloudflare.com"],
      "allow_mcp_servers": true,
      "allow_package_managers": true
    }
  }
}
