# DevOps — generated from cloud-devops.json (agent-templates/environments).
# NO SECRETS: every value here is readable by anyone who uses this environment.
# GITHUB_TOKEN is deliberately unset so the GitHub proxy injects credentials instead.

# Which FuzeOne environment this session is running in.
FUZE_ENV_ROLE=devops

# Hard boundary marker: this env edits manifests and opens PRs. It holds no kubeconfig; direct kubectl against prod stays on fuzeinfra-selfhosted-devops.
FUZE_GITOPS_ONLY=true

# Plain-text helm output reads better in a transcript.
HELM_DIFF_COLOR=false

# Opt this env into the A2A bridge SessionStart hook (a2a-bridge/). Cloud-only: dials an outbound WSS to the relay for cloud<->cloud session messaging.
FUZE_A2A_BRIDGE=1

# The A2A WSS relay the bridge connects to (agent-templates/orchestration/a2a_relay). Non-secret. The optional FUZE_A2A_RELAY_TOKEN bearer is set live, never committed.
FUZE_A2A_RELAY_URL=wss://relay.prod.fuzefront.com/ws

# The A2A delivery gateway (agent-templates/orchestration/a2a_gateway). a2a_send POSTs here; it runs `claude -p --cloud` to WAKE + deliver to an idle peer. Non-secret.
FUZE_A2A_GATEWAY_URL=https://a2a-gateway.prod.fuzefront.com
